# Copy this file to .env and fill in your real values. Never commit .env.
# DB1 is the source (the reference). DB2 is the target (compared against DB1).
#
# Each database has its own host, so they can be on different machines:
#   Same PC:        DB1_HOST=localhost       DB2_HOST=localhost
#   Different IPs:  DB1_HOST=192.168.1.10    DB2_HOST=192.168.1.20
#   Hostname:       DB1_HOST=db-server.company.com

# --- DB1: source database ---
DB1_HOST=192.168.1.10
DB1_PORT=5432
DB1_NAME=source_db
DB1_USER=postgres
DB1_PASSWORD=your_password
DB1_LABEL=Source

# --- DB2: target database ---
DB2_HOST=192.168.1.20
DB2_PORT=5432
DB2_NAME=target_db
DB2_USER=postgres
DB2_PASSWORD=your_password
DB2_LABEL=Target

# Optional settings (defaults shown)
# DB1_SCHEMA=public
# DB2_SCHEMA=public
# DB1_CONNECT_TIMEOUT=10
# DB2_CONNECT_TIMEOUT=10
