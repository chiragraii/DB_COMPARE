# Copy to .env and fill in credentials for live database comparison.
# Never commit real passwords.
#
# DB1 and DB2 can be on different machines/IPs, ports, and database names.
# Examples:
#   Same machine:     DB1_HOST=localhost     DB2_HOST=localhost
#   Different IPs:    DB1_HOST=192.168.1.10  DB2_HOST=10.0.0.25
#   Hostname/DNS:     DB1_HOST=db-prod.company.com

# --- Database 1 (source / left side) ---
DB1_HOST=192.168.1.10
DB1_PORT=5432
DB1_NAME=app_db
DB1_USER=postgres
DB1_PASSWORD=secret
DB1_SCHEMA=public
DB1_LABEL=DB-1

# --- Database 2 (target / right side) ---
DB2_HOST=10.0.0.25
DB2_PORT=5432
DB2_NAME=app_db
DB2_USER=postgres
DB2_PASSWORD=secret
DB2_SCHEMA=public
DB2_LABEL=DB-2
